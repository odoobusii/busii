<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Google Sheets Sync Cron Job -->
        <record id="ir_cron_gsheets_sync" model="ir.cron">
            <field name="name">Google Sheets: Check Configurations for Sync</field>
            <field name="model_id" ref="model_gsheets_sync"/>
            <field name="state">code</field>
            <field name="code">model.sync_all_active_mappings()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo> 