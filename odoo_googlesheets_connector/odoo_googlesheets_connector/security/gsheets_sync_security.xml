<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Google Sheets Sync Group -->
        <record id="group_gsheets_connector_user" model="res.groups">
            <field name="name">Google Sheets Sync User</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_gsheets_sync_manager" model="res.groups">
            <field name="name">Google Sheets Sync Manager</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('group_gsheets_connector_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Record Rules -->
        <record id="rule_gsheets_config_user" model="ir.rule">
            <field name="name">Google Sheets Config: User Access</field>
            <field name="model_id" ref="model_gsheets_config"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_gsheets_connector_user'))]"/>
        </record>

        <record id="rule_gsheets_mapping_user" model="ir.rule">
            <field name="name">Google Sheets Mapping: User Access</field>
            <field name="model_id" ref="model_gsheets_mapping"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_gsheets_connector_user'))]"/>
        </record>

        <record id="rule_gsheets_sync_log_user" model="ir.rule">
            <field name="name">Google Sheets Sync Log: User Access</field>
            <field name="model_id" ref="model_gsheets_sync_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_gsheets_connector_user'))]"/>
        </record>

    </data>
</odoo> 