<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Settings Form View for Odoo 17+ -->
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.gsheets</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <section string="Google Sheets Sync">
                        <field name="gsheets_sync_enabled"/>
                        <field name="gsheets_default_config_id"/>
                        <field name="gsheets_auto_sync"/>
                        <field name="gsheets_sync_interval"/>
                    </section>
                </xpath>
            </field>
        </record>

    </data>
</odoo> 