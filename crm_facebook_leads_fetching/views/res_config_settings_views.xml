<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_facebook_leads" model="ir.ui.view">
        <field name="name">res.config.settings.facebook.leads</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//app[@name='crm']" position="inside">
                <div id="crm_facebook_settings">

                    <h2>Facebook Leads Settings</h2>

                    <div class="row mt16 o_settings_container">

                        <!-- OPTION 1 -->
                        <div class="col-6 o_setting_box">
                            <div class="o_setting_right_pane">

                                <span class="o_form_label">
                                    Option 1 (Advanced): Use your own Facebook App
                                </span>

                                <div class="text-muted">
                                    Create a Facebook App
                                    <a href="https://developers.facebook.com/apps" target="_blank">here</a>
                                    and get the <strong>App ID</strong> and <strong>App Secret</strong>.
                                </div>

                                <div class="content_group mt16">

                                    <div class="row mb8">
                                        <div class="col-md-4">
                                            <span class="o_form_label">Facebook App ID</span>
                                        </div>
                                        <div class="col-md-8">
                                            <field name="crm_fb_app_id"/>
                                        </div>
                                    </div>

                                    <div class="row mb8">
                                        <div class="col-md-4">
                                            <span class="o_form_label">Facebook App Secret</span>
                                        </div>
                                        <div class="col-md-8">
                                            <field name="crm_fb_app_secret"/>
                                        </div>
                                    </div>

                                    <div invisible="not crm_fb_app_id or not crm_fb_app_secret">
                                        <button type="object"
                                                name="action_get_access_token"
                                                string="Get Access Token"
                                                icon="fa-arrow-right"
                                                class="btn-link"/>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- OPTION 2 -->
                        <div class="col-6 o_setting_box">
                            <div class="o_setting_right_pane">

                                <span class="o_form_label">
                                    Option 2 (Easy): Use Odoo Facebook App
                                </span>

                                <div class="text-muted">
                                    Use this option if you don’t have your own reviewed Facebook App.
                                </div>

                                <div class="content_group mt16">
                                    <a target="_blank"
                                       class="oe_link"
                                       href="https://www.facebook.com/v24.0/dialog/oauth?response_type=token&amp;client_id=165653190816042&amp;redirect_uri=https%3A%2F%2Fbadep.ma%2Fauth_oauth%2Fsignin&amp;scope=public_profile%2Cemail%2Cleads_retrieval%2Cpages_manage_ads%2Cpages_read_engagement%2Cads_management">
                                        <i class="fa fa-arrow-right"/>
                                        Use Odoo CRM Connector
                                    </a>
                                </div>

                            </div>
                        </div>

                        <!-- ACCESS TOKEN -->
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_right_pane">

                                <span class="o_form_label">
                                    Facebook User Access Token
                                </span>

                                <div class="text-muted">
                                    Paste long-lived User Access Token or use helper button.
                                </div>

                                <div class="content_group mt16">
                                    <field name="crm_fb_access_token"/>

                                    <div class="mt8" invisible="not crm_fb_access_token">
                                        <button type="object"
                                                name="action_get_facebook_pages"
                                                string="Get Pages"
                                                icon="fa-arrow-right"
                                                class="btn-link"/>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </xpath>

        </field>
    </record>
</odoo>
