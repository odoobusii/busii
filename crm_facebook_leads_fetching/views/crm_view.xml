                        <!--<pre>-->
                            <!--<field name="x_facebook_raw_data" nolabel="1"/>-->
                        <!--</pre>-->
                    <!--</div>-->
                <!--</xpath>-->

            </field>
        </record>

        <!-- Add fields to tree view -->



