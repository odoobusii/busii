<odoo>
    <data>
        <record id="crm_lead_view_form" model="ir.ui.view">
            <field name="name">crm.lead.form</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <xpath expr='//page[@name="lead"]' position='after'>
                    <page name="categorization" string="Facebook Info">
                        <group name="facebook_info" string="Facebook Info">
                            <field name="facebook_lead_id"/>
                            <field name="facebook_date_create"/>
                            <field name="facebook_page_id"/>
                            <field name="facebook_form_id"/>
                            <field name="facebook_adset_id"/>
                            <field name="facebook_ad_id"/>
                            <field name="facebook_campaign_id"/>
                            <field name="facebook_is_organic"/>
                        </group>
                    </page>
                </xpath>

                <xpath expr="//header" position="inside">
                    <button name="fetch_facebook_leads" type="object" string="Fetch Facebook Leads"
                            class="btn-primary" groups="sales_team.group_sale_manager"
                            confirm="Are you sure you want to fetch new leads from Facebook?"/>
                </xpath>
            </field>
        </record>

        <!-- Add custom fields to CRM Lead Form -->
        <record id="crm_lead_view_form_inherit_facebook" model="ir.ui.view">
            <field name="name">crm.lead.form.inherit.facebook</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">


                <!-- Add Facebook custom fields near email -->
                <xpath expr="//field[@name='email_from']" position="after">
                    <group string="Facebook Details">
                        <field name="project_timeline"/>
                        <field name="flooring_area"/>
                        <field name="callback_consent"/>
                        <field name="facebook_address"/>
                    </group>
                </xpath>

                <!-- Add raw data to description area -->
                <!--<xpath expr="//div[@name='message_ids']" position="before">-->
                    <!--<div class="alert alert-info" role="alert"-->
                         <!--invisible="not x_facebook_raw_data">-->
