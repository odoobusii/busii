<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_whatsapp_after_hours_log_list" model="ir.ui.view">
        <field name="name">whatsapp.after.hours.log.list</field>
        <field name="model">whatsapp.after.hours.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="create_date" string="Sent At"/>
                <field name="mobile_number"/>
                <field name="wa_account_id"/>
                <field name="whatsapp_message_id"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_after_hours_log_form" model="ir.ui.view">
        <field name="name">whatsapp.after.hours.log.form</field>
        <field name="model">whatsapp.after.hours.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <field name="mobile_number"/>
                        <field name="wa_account_id"/>
                        <field name="whatsapp_message_id"/>
                        <field name="create_date" string="Sent At"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_after_hours_log" model="ir.actions.act_window">
        <field name="name">After-Hours Auto-Reply Log</field>
        <field name="res_model">whatsapp.after.hours.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Settings > Technical > WhatsApp After-Hours Reply Log -->
    <menuitem id="menu_whatsapp_after_hours_log"
              name="After-Hours Reply Log"
              action="action_whatsapp_after_hours_log"
              parent="base.menu_custom"
              sequence="50"/>

</odoo>
