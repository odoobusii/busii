<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_retainer" model="ir.ui.view">
        <field name="name">res.partner.form.retainer</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Retainer" name="retainer" groups="project.group_project_user"
                      invisible="parent_id">
                    <group>
                        <group string="Settings">
                            <field name="retainer_hours" widget="float_time"/>
                            <field name="retainer_alert_threshold"/>
                            <field name="retainer_alert_user_ids" widget="many2many_tags"/>
                        </group>
                        <group string="This Month">
                            <label for="retainer_hours_used"/>
                            <div class="o_row">
                                <button name="action_view_retainer_timesheets" type="object"
                                        class="btn btn-link p-0 fw-bold d-inline-flex align-items-center text-nowrap"
                                        context="{'retainer_category': 'retainer'}"
                                        title="View the timesheets counted in this number">
                                    <field name="retainer_hours_used" widget="float_time"/>
                                    <i class="fa fa-external-link ms-1" role="img" aria-label="View timesheets"/>
                                </button>
                            </div>
                            <field name="retainer_usage_percent" widget="progressbar"
                                   invisible="retainer_hours &lt;= 0"/>
                            <field name="retainer_hours_total" widget="float_time"/>
                        </group>
                    </group>
                    <group>
                        <group string="Excluded from Retainer (This Month)">
                            <field name="retainer_hours_upskilling" widget="float_time"/>
                            <field name="retainer_hours_solution_investigation" widget="float_time"/>
                            <field name="retainer_hours_solution_definition" widget="float_time"/>
                            <field name="retainer_hours_development_request" widget="float_time"/>
                            <field name="retainer_hours_excluded" widget="float_time" class="fw-bold"/>
                        </group>
                    </group>
                    <field name="retainer_alert_ids" readonly="1" invisible="not retainer_alert_ids">
                        <list>
                            <field name="period_label"/>
                            <field name="retainer_hours" widget="float_time"/>
                            <field name="hours_used" widget="float_time"/>
                            <field name="usage_percent"/>
                            <field name="create_date" string="Alerted On"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
